[
  {
    "id": "q_ko_001",
    "text": "넘어진 김에 바닥에 떨어진 동전 하나 줍고 일어나는 게 깨비의 방식이지.",
    "category": "깨비말",
    "tone_tags": ["comic", "hope"]
  },
  {
