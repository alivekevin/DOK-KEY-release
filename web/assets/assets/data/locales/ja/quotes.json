[
  {
    "id": "quo_001",
    "text": "千年生きて分かったのは、運は呼べば少し早く来るということだ。",
    "category": "깨비말",
    "tone_tags": [
      "comic",
      "hope"
    ]
  },
  {
    "id": "quo_002",
    "text": "鍵は開けたい人の手の大きさに合わせて作られる。",
    "category": "생활속담",
    "tone_tags": [
      "calm",
      "passion"
    ]
  },
  {
    "id": "quo_003",
    "text": "今日が未完の障子紙でも、明日は貼り直せる。",
    "category": "깨비말",
    "tone_tags": [
      "calm",
      "irony"
    ]
  },
  {
    "id": "quo_004",
    "text": "雷が鳴る日は、天もたまには叫びたくなるということだ。",
    "category": "깨비말",
    "tone_tags": [
      "hope",
      "mystery"
    ]
  },
  {
    "id": "quo_005",
    "text": "月に一度は、自分を大安にしてみよう。",
    "category": "도깨비풍자",
    "tone_tags": [
      "conflict",
      "lonely"
    ]
  },
  {
    "id": "quo_006",
    "text": "迷い道は、地図を捨てた者だけが新しい道を見つける。",
    "category": "깨비말",
    "tone_tags": [
      "calm",
      "lonely"
    ]
  },
  {
    "id": "quo_007",
    "text": "笑いはどっきり棒の最高の攻略法だ。",
    "category": "깨비말",
    "tone_tags": [
      "chaos",
      "irony"
    ]
  },
  {
    "id": "quo_008",
    "text": "深夜の本音は、昼の挨拶より百倍正直だ。",
    "category": "생활속담",
    "tone_tags": [
      "meeting",
      "hope"
    ]
  },
  {
    "id": "quo_009",
    "text": "別れの残り香は、次の出会いの蝋燭になる。",
    "category": "생활속담",
    "tone_tags": [
      "farewell",
      "calm"
    ]
  },
  {
    "id": "quo_010",
    "text": "鏡に映る自分は、いつも半拍遅れて育っている。",
    "category": "도깨비풍자",
    "tone_tags": [
      "horror",
      "passion"
    ]
  },
  {
    "id": "quo_011",
    "text": "宝くじより確率が高いのは、隣の席に座る誰かが味方になることだ。",
    "category": "key",
    "tone_tags": [
      "hope"
    ]
  },
  {
    "id": "quo_012",
    "text": "火傷しそうな情熱こそ、一番長持ちするお湯だ。",
    "category": "night",
    "tone_tags": [
      "lonely",
      "mystery"
    ]
  },
  {
    "id": "quo_013",
